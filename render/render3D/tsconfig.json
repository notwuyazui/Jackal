{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true, "skipLibCheck": true,
    "paths": { "@cot/*": ["./vendor/cot/src/*"] },
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "maps/**/*.ts", "models/**/*.ts", "vite.config.ts"]
}
